RewriteEngine On

# This file sits in public_html, which also contains the mitothrum.com
# folder, so every rule below is limited to this site's own host names.

# One canonical host: send www to the bare domain
RewriteCond %{HTTP_HOST} ^www\.waterdamagegwinnett\.com$ [NC]
RewriteRule ^(.*)$ https://waterdamagegwinnett.com/$1 [R=301,L]

# Always https
RewriteCond %{HTTP_HOST} ^waterdamagegwinnett\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://waterdamagegwinnett.com/$1 [R=301,L]

# /index.html and /es/index.html go to / and /es/ (matched on the original
# request so the server's own DirectoryIndex lookup never loops)
RewriteCond %{HTTP_HOST} ^waterdamagegwinnett\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/+((?:[^/\s?]+/)*)index\.html[\s?] [NC]
RewriteRule ^ https://waterdamagegwinnett.com/%1 [R=301,L]

# Old backups, deploy archives and the hosting placeholder page are gone for good.
# 410 tells Google to drop them; they should also be deleted from the server.
RewriteRule ^(index-backup[^/]*\.html|home\.html|waterdamagegwinnett-deploy-[^/]*\.zip)$ - [G,L]

# Never serve archive files from the web root
<FilesMatch "\.(zip|tar|gz|bak|sql)$">
  Require all denied
</FilesMatch>

# Pages and feeds must be revalidated, so a deploy shows up immediately
# instead of an old cached copy. Images keep normal caching.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Notes files in the repository are never public
<FilesMatch "^(RULES|README|CLAUDE)\.md$">
  Require all denied
</FilesMatch>
