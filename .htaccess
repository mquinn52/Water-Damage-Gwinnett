RewriteEngine On

# This file sits in public_html, which also contains the mitothrum.com
# folder, so every rule below is limited to this site's own host names.

# One canonical host: send www to the bare domain
RewriteCond %{HTTP_HOST} ^www\.waterdamagegwinnett\.com$ [NC]
RewriteRule ^(.*)$ https://waterdamagegwinnett.com/$1 [R=301,L]

# Always https
RewriteCond %{HTTP_HOST} ^waterdamagegwinnett\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^(.*)$ https://waterdamagegwinnett.com/$1 [R=301,L]

# /index.html and /es/index.html go to / and /es/ (matched on the original
# request so the server's own DirectoryIndex lookup never loops)
RewriteCond %{HTTP_HOST} ^waterdamagegwinnett\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/+((?:[^/\s?]+/)*)index\.html[\s?] [NC]
RewriteRule ^ https://waterdamagegwinnett.com/%1 [R=301,L]

# Old backups, deploy archives and the hosting placeholder page are gone for good.
# 410 tells Google to drop them; they should also be deleted from the server.
RewriteRule ^(index-backup[^/]*\.html|home\.html|waterdamagegwinnett-deploy-[^/]*\.zip)$ - [G,L]

# Never serve archive files from the web root
<FilesMatch "\.(zip|tar|gz|bak|sql)$">
  Require all denied
</FilesMatch>

# Security headers: https only for a year, no framing by other sites, no MIME
# sniffing, limited referrer details on outbound clicks, and no camera,
# microphone, location or payment access for any page. Both sites send the
# same set (this file's copy also reaches anything inside its folder).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Full Content Security Policy (tested Oct 29, 2026 on every page with zero
  # violations): scripts, styles, fonts and analytics only from this site,
  # Google Fonts and Google Analytics; no plugins, no framing, no form posts
  # to other sites. Add a domain here before embedding anything new.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; img-src 'self' data: https://*.google-analytics.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# Pages and feeds must be revalidated, so a deploy shows up immediately
# instead of an old cached copy. Images keep normal caching.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Notes files in the repository are never public
<FilesMatch "^(RULES|README|CLAUDE|SOCIAL)\.md$">
  Require all denied
</FilesMatch>

# The deploy tool's file list (names and hashes of every uploaded file) is
# for the FTP sync only, never for the web.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
